<h2 class="flex justify-center text-2xl font-semibold mb-4">
  <%= formTitle %>
</h2>

<div class="grid grid-cols-12">
  <form
    method="POST" action="<%= formAction %>"
    class="col-span-8 col-start-3"
    id="collaboratorForm"
  >
    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">Họ và Tên:</label>
      <input
        type="text" name="name"
        value="<%= formData?.name || '' %>"
        data-initial-value="<%= formData?.name || '' %>"
        class="px-4 py-2 border rounded-md w-full col-span-3 form-input"
      >
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">Email:</label>
      <input
        type="email" name="email"
        value="<%= formData?.email || '' %>"
        data-initial-value="<%= formData?.email || '' %>"
        class="px-4 py-2 border rounded-md w-full col-span-3 form-input"
      >
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">Mật khẩu:</label>
      <input
        type="password" name="password"
        value="<%= formData?.password || '' %>"
        data-initial-value="<%= formData?.password || '' %>"
        class="px-4 py-2 border rounded-md w-full col-span-3 form-input"
      >
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">Số điện thoại:</label>
      <input
        type="tel" id="phoneNumber" name="phoneNumber"
        value="<%= formData?.phoneNumber || '' %>"
        data-initial-value="<%= formData?.phoneNumber || '' %>"
        class="px-4 py-2 border rounded-md w-full col-span-3 form-input"
      >
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">Ngày sinh:</label>
      <input
        type="date" id="dayOfBirth" name="dayOfBirth"
        value="<%= formData?.dayOfBirth || '' %>"
        data-initial-value="<%= formData?.dayOfBirth || '' %>"
        class="datepicker px-4 py-2 border rounded-md w-full col-span-3 form-input"
      >
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">Địa chỉ:</label>
      <input
        type="text" name="address"
        value="<%= formData?.address || '' %>"
        data-initial-value="<%= formData?.address || '' %>"
        class="px-4 py-2 border rounded-md w-full col-span-3 form-input"
      >
    </div>

    <div class="mt-4 flex justify-center">
      <button type="submit"
        class="px-6 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600">
        <%= formSubmitBtn %>
      </button>
    </div>
  </form>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('collaboratorForm');

  form.addEventListener('submit', function(e) {
    e.preventDefault();

    const formData = new FormData(form);
    const changedData = {};
    const inputs = form.querySelectorAll('.form-input');

    inputs.forEach(input => {
      const name = input.name;
      const currentValue = input.value;
      const initialValue = input.dataset.initialValue;

      if (currentValue !== initialValue) {
        changedData[name] = currentValue;
      }
    });

    fetch(form.action, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(changedData)
    })
    .then(response => {
      if (response.ok) {
        window.location.href = '/collaborators/edit';
      } else {
        throw new Error('Cập nhật thất bại');
      }
    })
    .catch(error => {
      console.error('Error:', error);
      alert('Có lỗi xảy ra khi cập nhật thông tin');
    });
  });
});
</script>
