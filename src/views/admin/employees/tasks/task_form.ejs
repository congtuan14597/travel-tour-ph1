<h2 class="flex justify-center text-2xl font-semibold mb-4">
  <%= formTitle %>
</h2>

<div class="grid grid-cols-12">
  <form
    method="POST" action="<%= formAction %>"
    class="col-span-8 col-start-3"
  >
    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">
        <span class="text-red-500">*</span> Nhân viên:
      </label>
      <select
        name="userId" required
        class="px-4 py-2 border rounded-md w-full col-span-3"
      >
        <option value="">-- Chọn nhân viên --</option>
        <% employees.forEach(employee => { %>
          <option value="<%= employee.id %>">
            <%= employee.name %>
          </option>
        <% }) %>
      </select>
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">
        <span class="text-red-500">*</span> Tiêu đề:
      </label>
      <input
        type="text" name="title"
        value="<%= formData?.title || '' %>" required
        class="px-4 py-2 border rounded-md w-full col-span-3"
      >
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">
        <span class="text-red-500">*</span> Nội dung công việc:
      </label>
      <textarea
        name="content" rows="4" required
        class="px-4 py-2 border rounded-md w-full col-span-3"
      >
        <%= formData?.content || '' %>
      </textarea>
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">
        <span class="text-red-500">*</span> Trạng thái:
      </label>
      <select
        name="status" required
        class="px-4 py-2 border rounded-md w-full col-span-3"
      >
        <option value="1">Mở</option>
        <option value="2">Đang thực hiện</option>
        <option value="3">Đã hoàn thành</option>
        <option value="4">Tạm hoãn</option>
      </select>
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">
        <span class="text-red-500">*</span> Ngày bắt đầu:
      </label>
      <input
        type="date" id="startDate" name="startDate"
        value="<%= formData?.startDate || '' %>"
        class="datepicker px-4 py-2 border rounded-md w-full col-span-3"
      >
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">
        <span class="text-red-500">*</span> Ngày kết thúc:
      </label>
      <input
        type="date" id="endDate" name="endDate"
        value="<%= formData?.endDate || '' %>"
        class="datepicker px-4 py-2 border rounded-md w-full col-span-3"
      >
    </div>

    <div class="mt-4 flex justify-center">
      <button type="submit"
        class="px-6 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600">
        <%= formSubmitBtn %>
      </button>
    </div>
  </form>
</div>
