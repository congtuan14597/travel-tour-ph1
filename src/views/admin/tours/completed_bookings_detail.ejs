<div class="content sm:ml-[17rem]">
  <div id="app" class="flex justify-center h-full bg-gray-200 p-4 mt-[53px]">
    <div class="w-full shadow-lg max-w-8xl bg-white p-6 rounded-lg">
      <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-semibold">
          Chi tiết booking đã hoàn thành
        </h2>
        <div class="flex items-center gap-2">
          <input
            type="month"
            id="monthPicker"
            class="px-4 py-2 border rounded-lg focus:outline-none
                  focus:ring-2 focus:ring-blue-500"
            value="<%= month %>"
          >
          <button
            onclick="changeMonth()"
            class="px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700
                  focus:outline-none focus:ring-2 focus:ring-blue-500"
          >
            Xem
          </button>
        </div>
      </div>

      <!-- Thống kê tổng quan -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="bg-blue-50 p-4 rounded-lg">
          <h3 class="font-semibold text-blue-700">Tổng số booking</h3>
          <p class="text-2xl font-bold text-blue-600"><%= totalBookings %></p>
        </div>
        <div class="bg-green-50 p-4 rounded-lg">
          <h3 class="font-semibold text-green-700">Tổng số khách</h3>
          <p class="text-2xl font-bold text-green-600"><%= totalCustomers %></p>
        </div>
        <div class="bg-amber-50 p-4 rounded-lg">
          <h3 class="font-semibold text-amber-700">Tổng doanh thu</h3>
          <p class="text-2xl font-bold text-amber-600">
            <%= totalRevenue.toLocaleString() %> VND
          </p>
        </div>
      </div>

      <!-- Bảng chi tiết booking -->
      <div class="overflow-x-auto">
        <table class="min-w-full bg-white">
          <thead class="bg-gray-50">
            <tr>
              <th
                class="px-6 py-3 text-left text-xs font-medium
                      text-gray-500 uppercase tracking-wider"
              >
                Ngày
              </th>
              <th
                class="px-6 py-3 text-left text-xs font-medium
                      text-gray-500 uppercase tracking-wider"
              >
                Tour
              </th>
              <th
                class="px-6 py-3 text-left text-xs font-medium
                      text-gray-500 uppercase tracking-wider"
              >
                Khách hàng
              </th>
              <th
                class="px-6 py-3 text-left text-xs font-medium
                      text-gray-500 uppercase tracking-wider"
              >
                Số người
              </th>
              <th
                class="px-6 py-3 text-left text-xs font-medium
                      text-gray-500 uppercase tracking-wider"
              >
                Đơn giá
              </th>
              <th
                class="px-6 py-3 text-left text-xs font-medium
                      text-gray-500 uppercase tracking-wider"
              >
                Thành tiền
              </th>
            </tr>
          </thead>
          <tbody class="bg-white divide-y divide-gray-200">
            <% bookings.forEach(booking => { %>
              <tr>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= booking.createdAt.toLocaleDateString('vi-VN') %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= booking.tours.name %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <div><%= booking.users.name %></div>
                  <div class="text-gray-500 text-xs">
                    <%= booking.users.email %>
                  </div>
                  <div class="text-gray-500 text-xs">
                    <%= booking.users.phoneNumber %>
                  </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= booking.numberPeople || 0 %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= booking.tours.price.toLocaleString() %> VND
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">
                  <%= booking.revenue.toLocaleString() %> VND
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<script>
  function changeMonth() {
    const monthPicker = document.getElementById('monthPicker');
    const selectedDate = new Date(monthPicker.value);
    const year = selectedDate.getFullYear();
    const month = String(selectedDate.getMonth() + 1).padStart(2, '0');

    window.location.href = `/admin/tours/completed_bookings?month=${year}-${month}`;
  }

  document.addEventListener('DOMContentLoaded', function() {
    const monthPicker = document.getElementById('monthPicker');
    if (!monthPicker.value) {
      const today = new Date();
      const year = today.getFullYear();
      const month = String(today.getMonth() + 1).padStart(2, '0');
      monthPicker.value = `${year}-${month}`;
      changeMonth();
    }
  });
</script>
