<div class="content sm:ml-[17rem]">
  <div id="app" class="flex justify-center h-full bg-gray-200 p-4 mt-[53px]">
    <div class="w-full shadow-lg max-w-8xl bg-white p-6 rounded-lg sm:flex">
      <div class="w-full">
        <% if (typeof error !== 'undefined') { %>
          <div class="col-span-12 bg-red-100 text-red-800 p-3 rounded mb-4">
            <%- error %>
          </div>
        <% } %>

        <div class="flex justify-end items-center">
          <!-- Nút tạo mới -->
          <a
            href="/admin/collaborators/new"
            class="w-[6rem] p-2 bg-green-500 text-center
                  text-white rounded-md hover:bg-green-600"
          >
            Tạo mới
          </a>
        </div>

        <div class="overflow-x-auto">
          <!-- Danh sách cộng tác viên -->
          <table
            class="table-auto border border-gray-200 rounded-lg w-full
                  overflow-hidden shadow-lg mt-5"
          >
            <thead class="bg-gray-200">
              <tr>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  ID
                </th>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  Họ và Tên
                </th>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  Email
                </th>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  Số điện thoại
                </th>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  Ngày sinh
                </th>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  Địa chỉ
                </th>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                ></th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% if(collaborators.length > 0) { %>
                <% collaborators.forEach((collaborator, index) => { %>
                  <tr class="hover:bg-gray-50">
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= collaborator.id %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= collaborator.name %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= collaborator.email %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= collaborator.phoneNumber %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= moment(collaborator.dayOfBirth).format("DD/MM/YYYY") %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= collaborator.address %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <!-- Nút chỉnh sửa -->
                      <a
                        href="/admin/collaborators/edit/<%= collaborator.id %>"
                        class="w-[6rem] p-2 bg-gray-500 text-center
                              text-white rounded-md hover:bg-gray-600"
                      >
                        Chỉnh sửa
                      </a>
                      <!-- Nút xóa -->
                      <button
                        type="button"
                        class="w-[3rem] p-[0.35rem] bg-red-500 text-center ml-2
                              text-white rounded-md hover:bg-red-600"
                        onclick="deleteCollaborator('<%= collaborator.id %>');"
                      >
                        Xóa
                      </button>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr class="hover:bg-gray-50">
                  <td
                    class="p-2 text-sm text-gray-800 text-center"
                    colspan="15"
                  >
                    <p>Không có dữ liệu được tìm thấy</p>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <%- include("../components/pagination") %>
      </div>
    </div>
  </div>
</div>

<script>
  function deleteCollaborator(collaboratorId) {
    if (confirm("Bạn có chắc chắn muốn xóa cộng tác viên này?")) {
      $.ajax({
        url: `/admin/collaborators/${collaboratorId}`,
        type: "DELETE",
        success: function () {
          window.location.reload();
        },
        error: function () {
          alert("Lỗi khi xóa cộng tác viên!");
        },
      });
    }
  }
</script>
