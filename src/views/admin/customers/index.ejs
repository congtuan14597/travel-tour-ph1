<div class="content sm:ml-[17rem]">
  <div id="app" class="flex justify-center h-full bg-gray-200 p-4 mt-[53px]">
    <div class="w-full shadow-lg max-w-8xl bg-white p-6 rounded-lg sm:flex">
      <div class="w-full">
        <div class="flex justify-between items-center">
          <!-- Form tìm kiếm -->
          <form method="GET" action="/admin/customers" class="flex space-x-2 w-full">
            <input
              type="text" name="search" placeholder="Nhập số công văn..."
              value="<%= searchQuery %>" id="search-customers"
              class="px-4 py-2 border rounded-md w-1/3"
            />
            <button
              type="submit"
              class="ml-2 px-4 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600"
            >
              Tìm kiếm
            </button>
          </form>

          <!-- Nút tạo mới -->
          <a
            href="/admin/customers/new"
            class="w-[6rem] p-2 bg-green-500 text-center
                  text-white rounded-md hover:bg-green-600"
          >
            Tạo mới
          </a>
        </div>

        <div class="overflow-x-auto">
          <!-- Danh sách khách hàng -->
          <table
            class="table-auto border border-gray-200 rounded-lg
                  overflow-hidden shadow-lg mt-5"
          >
            <thead class="bg-gray-200">
              <tr>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  Số công văn
                </th>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  ID thẻ
                </th>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  Họ và Tên</thclass=>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  Ngày sinh
                </th>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  Giới tính</thclass=>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  Quốc tịch
                </th>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  Địa chỉ</thclass=>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  Ngày tạo thẻ
                </th>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  Thôn</thclass=>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  Tỉnh
                </th>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  Huyện</thclass=>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  Xã
                </th>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  Mã tỉnh</thclass=>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  Mã huyện
                </th>
                <th
                  class="p-2 text-left text-sm font-semibold whitespace-nowrap
                        text-gray-600 uppercase border-b"
                >
                  Mã xã</thclass=>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% if(customers.length > 0) { %>
                <% customers.forEach((customer, index) => { %>
                  <tr class="hover:bg-gray-50">
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= customer.documentNumber %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= customer.cardID %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= customer.fullName %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= moment(customer.dayOfBirth).format("DD/MM/YYYY") %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= customer.gender %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= customer.national %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= customer.address %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= moment(customer.createdAtCard).format("DD/MM/YYYY") %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= customer.village %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= customer.province %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= customer.district %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= customer.commune %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= customer.provinceCode %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= customer.districtCode %>
                    </td>
                    <td class="p-2 text-sm text-gray-800 whitespace-nowrap">
                      <%= customer.communeCode %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr class="hover:bg-gray-50">
                  <td
                    class="p-2 text-sm text-gray-800 text-center"
                    colspan="15"
                  >
                    <p>Không có dữ liệu được tìm thấy</p>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <%- include("../components/pagination") %>

        <div class="mt-4">
          <button
            type="button" id="exportBtn"
            class="p-2 bg-gray-500 text-white rounded-md hover:bg-gray-600"
          >
            Xuất tập tin
          </button>
        </div>
      </div>
    </div>
  </div>
</div>
