<h2 class="flex justify-center text-2xl font-semibold mb-4">
  <%= formTitle %>
</h2>

<div class="grid grid-cols-12">
  <form
    method="POST" action="<%= formAction %>"
    class="col-span-8 col-start-3"
  >
    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">
        <span class="text-red-500">*</span> Số công văn:
      </label>
      <input
        type="text" name="documentNumber"
        value="<%= formData?.documentNumber || '' %>" required
        class="px-4 py-2 border rounded-md w-full col-span-3"
      >
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">
        <span class="text-red-500">*</span> ID thẻ:
      </label>
      <input
        type="text" name="cardID"
        value="<%= formData?.cardID || '' %>" required
        class="px-4 py-2 border rounded-md w-full col-span-3"
      >
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">
        <span class="text-red-500">*</span> Họ và Tên:
      </label>
      <input
        type="text" name="fullName"
        value="<%= formData?.fullName || '' %>" required
        class="px-4 py-2 border rounded-md w-full col-span-3"
      >
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">
        <span class="text-red-500">*</span> Ngày sinh:
      </label>
      <input
        type="text" id="dayOfBirth" name="dayOfBirth" required
        value="<%= formData?.dayOfBirth
          ? moment(formData.dayOfBirth, 'YYYY-MM-DD').format('DD-MM-YYYY')
          : '' %>"
        class="datepicker px-4 py-2 border rounded-md w-full col-span-3"
      >
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">
        <span class="text-red-500">*</span> Giới tính:
      </label>
      <select
        name="gender" class="px-4 py-2 border rounded-md w-full col-span-3"
      >
        <option value="Nam" <%= formData?.gender === 'Nam' ? 'selected' : '' %>>
          Nam
        </option>
        <option value="Nữ" <%= formData?.gender === 'Nữ' ? 'selected' : '' %>>
          Nữ
        </option>
      </select>
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">
        <span class="text-red-500">*</span> Quốc tịch:
      </label>
      <select
        name="national" class="px-4 py-2 border rounded-md w-full col-span-3"
      >
        <option value="Việt Nam" <%= formData?.national === 'Việt Nam' ? 'selected' : '' %>>
          Việt Nam
        </option>
        <option value="Trung Quốc" <%= formData?.national === 'Trung Quốc' ? 'selected' : '' %>>
          Trung Quốc
        </option>
      </select>
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">Nơi sinh:</label>
      <input
        type="text" name="placeOfBirth"
        value="<%= formData?.placeOfBirth || '' %>"
        class="px-4 py-2 border rounded-md w-full col-span-3"
      >
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">Thôn:</label>
      <input
        type="text" name="village"
        value="<%= formData?.village || '' %>"
        class="px-4 py-2 border rounded-md w-full col-span-3"
      >
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">
        <span class="text-red-500">*</span> Ngày làm thẻ:
      </label>
      <input
        type="text" id="createdAtCard" name="createdAtCard" required
        value="<%= formData?.createdAtCard
          ? moment(formData.createdAtCard, 'YYYY-MM-DD').format('DD-MM-YYYY')
          : '' %>"
        class="datepicker px-4 py-2 border rounded-md w-full col-span-3"
      >
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">Tỉnh/Thành phố:</label>
      <select
        id="province" name="province"
        class="px-4 py-2 border rounded-md w-full col-span-3"
      >
        <option value="">Chọn Tỉnh/Thành phố</option>
      </select>
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">Quận/Huyện:</label>
      <select
        id="district" name="district"
        class="px-4 py-2 border rounded-md w-full col-span-3"
      >
        <option value="">Chọn Quận/Huyện</option>
      </select>
    </div>

    <div class="grid grid-cols-4 gap-4 items-center mb-5">
      <label class="block text-sm font-medium">Xã/Phường:</label>
      <select
        id="commune" name="commune"
        class="px-4 py-2 border rounded-md w-full col-span-3"
      >
        <option value="">Chọn Xã/Phường</option>
      </select>
    </div>

    <div class="mt-4 flex justify-center">
      <button type="submit"
        class="px-6 py-2 bg-blue-500 text-white rounded-md hover:bg-blue-600">
        <%= formSubmitBtn %>
      </button>
    </div>
  </form>
</div>

<script>
const provinceSelect = document.getElementById('province');
const districtSelect = document.getElementById('district');
const communeSelect = document.getElementById('commune');

// Hàm xử lý tên địa danh
function formatLocationName(name) {
  return name
    .replace(/^Tỉnh |^Thành phố |^Quận |^Huyện |^Thị xã |^Phường |^Xã |^Thị trấn /i, '')
    .trim();
}

// Hàm sắp xếp theo bảng chữ cái tiếng Việt
function sortVietnamese(a, b) {
  return a.localeCompare(b, 'vi');
}

// Fetch tỉnh/thành phố
async function fetchProvinces() {
  const response = await fetch('https://provinces.open-api.vn/api/p/');
  const data = await response.json();
  
  const sortedData = data.sort((a, b) => 
    sortVietnamese(formatLocationName(a.name), formatLocationName(b.name))
  );
  
  sortedData.forEach(province => {
    const option = document.createElement('option');
    option.value = formatLocationName(province.name);
    option.dataset.code = province.code;
    option.textContent = formatLocationName(province.name);
    if (formatLocationName(province.name) === '<%= formData?.province %>') {
      option.selected = true;
      // Nếu có sẵn tỉnh/thành phố, fetch quận/huyện
      fetchDistricts(province.code);
    }
    provinceSelect.appendChild(option);
  });
}

// Fetch quận/huyện theo tỉnh/thành phố
async function fetchDistricts(provinceCode) {
  districtSelect.innerHTML = '<option value="">Chọn Quận/Huyện</option>';
  communeSelect.innerHTML = '<option value="">Chọn Xã/Phường</option>';
  
  if (!provinceCode) return;
  
  const response = await fetch(`https://provinces.open-api.vn/api/p/${provinceCode}?depth=2`);
  const data = await response.json();
  
  const sortedDistricts = data.districts.sort((a, b) => 
    sortVietnamese(formatLocationName(a.name), formatLocationName(b.name))
  );
  
  sortedDistricts.forEach(district => {
    const option = document.createElement('option');
    option.value = formatLocationName(district.name);
    option.dataset.code = district.code;
    option.textContent = formatLocationName(district.name);
    if (formatLocationName(district.name) === '<%= formData?.district %>') {
      option.selected = true;
      // Nếu có sẵn quận/huyện, fetch xã/phường
      fetchCommunes(district.code);
    }
    districtSelect.appendChild(option);
  });
}

// Fetch xã/phường theo quận/huyện
async function fetchCommunes(districtCode) {
  communeSelect.innerHTML = '<option value="">Chọn Xã/Phường</option>';
  
  if (!districtCode) return;
  
  const response = await fetch(`https://provinces.open-api.vn/api/d/${districtCode}?depth=2`);
  const data = await response.json();
  
  const sortedWards = data.wards.sort((a, b) => 
    sortVietnamese(formatLocationName(a.name), formatLocationName(b.name))
  );
  
  sortedWards.forEach(commune => {
    const option = document.createElement('option');
    option.value = formatLocationName(commune.name);
    option.textContent = formatLocationName(commune.name);
    if (formatLocationName(commune.name) === '<%= formData?.commune %>') {
      option.selected = true;
    }
    communeSelect.appendChild(option);
  });
}

// Event listeners
provinceSelect.addEventListener('change', (e) => {
  const selectedOption = e.target.options[e.target.selectedIndex];
  fetchDistricts(selectedOption.dataset.code);
});

districtSelect.addEventListener('change', (e) => {
  const selectedOption = e.target.options[e.target.selectedIndex];
  fetchCommunes(selectedOption.dataset.code);
});

// Load provinces on page load
fetchProvinces();
</script>
